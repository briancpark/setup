brew "htop"                      # GPL-2.0-or-later
brew "icarus-verilog"            # GPL-2.0-or-later AND LGPL-2.1-or-later
brew "mosh"                      # GPL-3.0-or-later
brew "wget"                      # GPL-3.0-or-later
cask "vlc"                       # GPL-2.0-or-later (libVLC: LGPL-2.1-or-later)

### Source-available / not OSI-approved ###
