brew "bat"                       # Apache-2.0 OR MIT
brew "clang-format"              # Apache-2.0 WITH LLVM-exception
brew "cmake"                     # BSD-3-Clause
brew "fastfetch"                 # MIT (replaces neofetch, which Homebrew removed)
brew "fzf"                       # MIT
brew "llvm"                      # Apache-2.0 WITH LLVM-exception
brew "mactop"                    # MIT
brew "neovim"                    # Apache-2.0
brew "open-mpi"                  # BSD-3-Clause-Open-MPI AND mpich2
brew "tmux"                      # ISC
brew "vim"                       # Vim
brew "xcbeautify"                # MIT
cask "font-meslo-lg-nerd-font"   # Apache-2.0 (Meslo) + MIT (Nerd Fonts patcher)
cask "ghostty"                   # MIT

### Copyleft with runtime/linking exception ###
brew "gcc"                       # GPL-3.0-or-later WITH GCC-exception-3.1

### Copyleft (GPL) ###
brew "ccache"                    # GPL-3.0-or-later
